# Copy to .env for local development (never commit .env).
# On Vercel, set these under Project Settings > Environment Variables instead.

# --- AI providers (all optional) -------------------------------------------
# Without any key the app still works using on-device OCR, the built-in food list and recipe book.
# Set one or both. In the app, Settings > AI models lets you choose, per feature,
# which provider is used (only providers with a key here can be chosen).
# Defaults are the fastest, cheapest model of each provider, at low reasoning effort.

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
# ANTHROPIC_RECEIPT_MODEL=claude-haiku-5-5
# ANTHROPIC_MODEL=claude-haiku-5-5     # recipes; try claude-sonnet-5-5 for richer recipes

# OpenAI GPT (platform.openai.com)
OPENAI_API_KEY=
# OPENAI_RECEIPT_MODEL=gpt-6-luna
# OPENAI_MODEL=gpt-6-luna              # recipes; try gpt-6.1-sol for richer recipes

# Local open-source models via Ollama (ollama.com): free, no key. On by default when the app runs on
# your own computer, and offered only while Ollama is running with the models downloaded
# (ollama pull qwen3-vl:2b-instruct && ollama pull qwen3:4b-instruct).
# Use the "-instruct" tags: the plain qwen3-vl:2b / qwen3:4b are thinking models and don't work well here.
# LOCAL_LLM=off                          # switch the local option off
# LOCAL_LLM_URL=http://127.0.0.1:11434   # an Ollama on another machine
# LOCAL_RECEIPT_MODEL=qwen3-vl:2b-instruct   # try qwen3-vl:4b-instruct for better accuracy (slower)
# LOCAL_MODEL=qwen3:4b-instruct

# --- Access control ---------------------------------------------------------
# Required on Vercel whenever any API key is set. Your deployment URL is public, so this
# shared secret stops strangers from spending your API credits. You type it once in the app
# (Settings > AI access code). Pick something long and random.
APP_ACCESS_CODE=
