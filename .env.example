# Copy to .env for local development (never commit .env).
# On Vercel, set these under Project Settings > Environment Variables instead.

# Optional. Without it the app still works using the built-in food list and recipe book.
ANTHROPIC_API_KEY=

# Required on Vercel whenever ANTHROPIC_API_KEY is set. Your deployment URL is public, so this
# shared secret stops strangers from spending your API credits. You type it once in the app
# (Settings > AI access code). Pick something long and random.
APP_ACCESS_CODE=

# Optional model overrides.
# Receipt parsing is simple extraction, so it defaults to the cheapest model:
# ANTHROPIC_RECEIPT_MODEL=claude-haiku-5-5
# Recipe writing defaults to a stronger model (set claude-haiku-5-5 here to cut cost further):
# ANTHROPIC_MODEL=claude-opus-5-5
