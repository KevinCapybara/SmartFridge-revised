{
  "name": "smartfridge",
  "version": "1.0.0",
  "description": "SmartFridge: scan a grocery receipt, track what's in your fridge, see what's expiring, get recipes.",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:lan": "node server.js --lan",
    "dev": "node --watch server.js",
    "test": "node --test",
    "check-secrets": "node scripts/check-secrets.mjs --all",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "engines": {
    "node": ">=20.12"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "express": "^5.2.1",
    "openai": "^7.30.0"
  }
}
